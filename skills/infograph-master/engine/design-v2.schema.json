{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "version",
    "brief",
    "evidence",
    "visual",
    "narrative",
    "spatial",
    "interaction",
    "validation"
  ],
  "properties": {
    "version": {
      "const": "2.0"
    },
    "brief": {
      "type": "object",
      "required": [
        "audience",
        "purpose"
      ],
      "properties": {
        "audience": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "source",
          "unit",
          "period"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "period": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 0
    },
    "visual": {
      "type": "object",
      "required": [
        "style",
        "type",
        "material"
      ],
      "properties": {
        "style": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "serif",
            "sans",
            "mono"
          ]
        },
        "material": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "narrative": {
      "type": "object",
      "required": [
        "thesis",
        "scenes"
      ],
      "properties": {
        "thesis": {
          "type": "string",
          "minLength": 1
        },
        "scenes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "question",
              "before",
              "after",
              "composition",
              "blocks"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "question": {
                "type": "string",
                "minLength": 1
              },
              "before": {
                "type": "string",
                "minLength": 1
              },
              "after": {
                "type": "string",
                "minLength": 1
              },
              "composition": {
                "type": "string",
                "minLength": 1
              },
              "blocks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "role",
                    "task",
                    "fields",
                    "evidenceIds"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "role": {
                      "type": "string",
                      "minLength": 1
                    },
                    "task": {
                      "type": "string",
                      "minLength": 1
                    },
                    "fields": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "minItems": 0
                    },
                    "evidenceIds": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "minItems": 1
                    }
                  }
                },
                "minItems": 1
              }
            }
          },
          "minItems": 1
        }
      }
    },
    "spatial": {
      "type": "object",
      "required": [
        "coordinateSystem",
        "objects"
      ],
      "properties": {
        "coordinateSystem": {
          "enum": [
            "abstract",
            "geographic",
            "engineering"
          ]
        },
        "objects": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "position"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "position": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              }
            }
          },
          "minItems": 0
        }
      }
    },
    "interaction": {
      "type": "object",
      "required": [
        "initial",
        "transitions"
      ],
      "properties": {
        "initial": {
          "type": "string",
          "minLength": 1
        },
        "transitions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "from",
              "to",
              "motion",
              "trigger"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "from": {
                "type": "string",
                "minLength": 1
              },
              "to": {
                "type": "string",
                "minLength": 1
              },
              "motion": {
                "type": "string",
                "minLength": 1
              },
              "trigger": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "minItems": 0
        }
      }
    },
    "validation": {
      "type": "object",
      "required": [
        "required",
        "results"
      ],
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "check",
              "status"
            ],
            "properties": {
              "check": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "pass",
                  "fail",
                  "not-run"
                ]
              }
            }
          },
          "minItems": 0
        }
      }
    }
  }
}